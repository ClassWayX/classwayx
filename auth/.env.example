BETTER_AUTH_SECRET=
# 本地 Compose 访问地址；生产环境改为外部访问地址。
BETTER_AUTH_URL=http://localhost:3002
# Prisma 迁移使用管理账号，对应根目录的 DB_USER、DB_PASSWORD 和 AUTH_DB_NAME。
DATABASE_URL=postgresql://classwayx:awesome-password@postgres:5432/auth_db?schema=app
# 与根目录的 AUTH_USER、AUTH_USER_PASSWORD、AUTH_DB_NAME 对应，密码须 URL 编码。
AUTH_USER_DATABASE_URL=postgresql://auth:awesome-password@postgres:5432/auth_db?schema=app
