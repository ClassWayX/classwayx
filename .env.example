# ====================
# PostgreSQL 数据库用户名

DB_USER=classwayx
# ====================

# ====================
# PostgreSQL 数据库密码
#
# 提醒：请将此改成一个难以破解的强密码

DB_PASSWORD='awesome-password'
# ====================

# ====================
# PostgreSQL 数据库名称

DB_NAME=classwayx_db
# ====================


# 飞书机器人数据库
LARK_BOT_USER=lark_bot
LARK_BOT_USER_PASSWORD='awesome-password'
LARK_BOT_DB_NAME=lark_bot_db

# 认证服务数据库
AUTH_USER=auth
AUTH_USER_PASSWORD='awesome-password'
AUTH_DB_NAME=auth_db

# 接入 ACR 后填写控制台提供的完整镜像地址，建议固定版本或 digest。
# 留空时使用本地生产镜像名；本地开发 override 使用独立的开发镜像名。
# LARK_BOT_IMAGE=
# LARK_BOT_MIGRATION_IMAGE=
# AUTH_IMAGE=
# AUTH_MIGRATION_IMAGE=
# POSTGRES_IMAGE=
# APP_IMAGE=
