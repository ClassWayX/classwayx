# 复制为 docker-compose.override.yml 后，本地 docker compose up 会自动加载。
# 此文件不需要进行版本管理。!override 需要 Docker Compose 2.24.4 或更高版本。

services:
  # app 暂未启用；需要时同时取消基础文件和此处的注释。
#  app:
#    build:
#      context: ./app
#      target: dev
#    image: classwayx-app-dev
#    container_name: classwayx-app-dev-container
#    ports: !override
#      - "3000:3000"
#    restart: "no"
#    volumes:
#      - ./app:/app
#      - /app/node_modules

  lark-bot-db-migration:
    image: classwayx-lark-bot-migration-dev
    volumes:
      - ./lark-bot/prisma:/app/prisma
      - ./lark-bot/prisma7.config.ts:/app/prisma7.config.ts

  lark-bot:
    build:
      context: ./lark-bot
      target: dev
    image: classwayx-lark-bot-dev
    container_name: classwayx-lark-bot-dev-container
    ports: !override
      - "3001:3000"
    restart: "no"
    volumes:
      - ./lark-bot:/app
      - /app/node_modules
      - /app/.next
      - /app/app/generated/prisma

  postgres:
    ports:
      - "127.0.0.1:5432:5432"
